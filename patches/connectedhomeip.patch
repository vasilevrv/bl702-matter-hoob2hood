+CHIP_ERROR BflbConfig::FactoryResetRaw(void)
+{
+    constexpr uint32_t kExpectedPsmOffset = 0xE4000U;
+    constexpr uint32_t kExpectedPsmSize   = 0x10000U;
+    bl_mtd_handle_t handle = nullptr;
+    bl_mtd_info_t info      = {};
+
+    if (bl_mtd_open(BL_MTD_PARTITION_NAME_PSM, &handle, BL_MTD_OPEN_FLAG_BUSADDR) < 0 || handle == nullptr)
+    {
+        printf("[FACTORY_RESET] PSM open failed\r\n");
+        return CHIP_ERROR_PERSISTED_STORAGE_FAILED;
+    }
+
+    const int infoResult = bl_mtd_info(handle, &info);
+    const bool validPsm = infoResult == 0 && info.offset == kExpectedPsmOffset && info.size == kExpectedPsmSize &&
+        bl_flash_fw_protect_allow_region(info.offset, info.size) == 0;
+    if (validPsm)
+    {
+        printf("[FACTORY_RESET] PSM offset=0x%08lx size=0x%08lx\r\n",
+               static_cast<unsigned long>(info.offset), static_cast<unsigned long>(info.size));
+    }
+    else
+    {
+        printf("[FACTORY_RESET] Invalid PSM: info=%d offset=0x%08lx size=0x%08lx\r\n",
+               infoResult, static_cast<unsigned long>(info.offset), static_cast<unsigned long>(info.size));
+    }
+
+    const int eraseResult = validPsm ? bl_flash_erase(info.offset, static_cast<int>(info.size)) : -1;
+    const int closeResult = bl_mtd_close(handle);
+    printf("[FACTORY_RESET] erase=%d close=%d\r\n", eraseResult, closeResult);
+    return (eraseResult == 0 && closeResult == 0) ? CHIP_NO_ERROR : CHIP_ERROR_PERSISTED_STORAGE_FAILED;
+}
